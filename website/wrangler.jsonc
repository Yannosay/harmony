{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harmony-yannosay",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "harmony.yannosay.com", "custom_domain": true }
  ]
}
